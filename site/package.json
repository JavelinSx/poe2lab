{
  "name": "poe2lab-site",
  "private": true,
  "type": "module",
  "description": "poe2lab's site: a catalog of Path of Exile 2 builds published from the poe2lab app",
  "scripts": {
    "dev": "nuxt dev --port 3100",
    "build": "nuxt build",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "test": "vitest run",
    "smoke": "node scripts/smoke.mjs",
    "db:migrate": "wrangler d1 migrations apply poe2lab --local",
    "typecheck": "nuxi typecheck"
  },
  "dependencies": {
    "nuxt": "^4.5.2",
    "vue": "^3.5.43",
    "vue-router": "^4.6.0"
  },
  "devDependencies": {
    "nitro-cloudflare-dev": "^0.2.2",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3",
    "vue-tsc": "^3.3.12",
    "wrangler": "^4.147.0"
  }
}
